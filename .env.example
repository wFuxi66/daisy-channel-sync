# Postgres : local (docker compose) ou Supabase (pooler Supavisor, port 6543, mode transaction).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/daisy
# Protège /api/cron/sync. Vercel l'envoie automatiquement en Bearer aux crons.
CRON_SECRET=dev-cron-secret
# Démo locale : boutons de simulation (ventes partenaires, panne) branchés sur le mock.
DEMO_MODE=1
APP_URL=http://localhost:3000
MOCK_ARTISIA_PORT=4010
